---
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #F7F6F1; --ink: #1D1B24; --ink-dim: #6C6A72; --line: #E4E1D3; --accent: #2F5FDB; --accent-soft: #E8EDFC;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg); color: var(--ink); font-family: 'Inter', sans-serif; line-height: 1.65; }
    a { color: inherit; }
    .page { max-width: 760px; margin: 0 auto; padding: 40px 24px 100px; }
    header.masthead { background: var(--ink); }
    .masthead-inner { max-width: 920px; margin: 0 auto; padding: 22px 24px; }
    .wordmark { font-family: 'Fraunces', serif; font-weight: 600; font-style: italic; font-size: 26px; color: #F7F6F1; }
    .kicker { font-size: 13px; color: var(--ink-dim); margin-bottom: 28px; }
    .topic-chip { display: inline-block; font-size: 11.5px; font-weight: 600; padding: 5px 11px; border-radius: 20px; background: var(--accent-soft); color: var(--accent); margin-bottom: 14px; }
    h1 { font-family: 'Fraunces', serif; font-weight: 700; font-size: 32px; line-height: 1.2; margin-bottom: 12px; }
    h2 { font-family: 'Fraunces', serif; font-weight: 600; font-size: 19px; margin: 26px 0 10px; }
    .dek, .meta { color: var(--ink-dim); font-size: 15px; margin-bottom: 18px; }
    article p { font-size: 17px; margin-bottom: 16px; max-width: 64ch; }
    .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
    .card { border: 1px solid var(--line); border-radius: 8px; padding: 16px; background: white; }
    .back { display: inline-block; margin-bottom: 24px; font-size: 13px; color: var(--ink-dim); }
    .tags { display: flex; gap: 8px; margin-top: 28px; }
    .tags span { font-size: 11px; border: 1px solid var(--line); padding: 5px 10px; border-radius: 3px; }
    .empty { color: var(--ink-dim); font-style: italic; }
  </style>
</head>
<body>
  <header class="masthead"><div class="masthead-inner"><a class="wordmark" href="/">Compile.</a></div></header>
  <div class="page"><slot /></div>
</body>
</html>
